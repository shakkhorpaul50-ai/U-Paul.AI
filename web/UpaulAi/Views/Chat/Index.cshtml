@model List<UPaulAi.Models.ChatMessage>
@{
    ViewData["Title"] = "Chat";
}
<div class="chat-wrap">
    <div class="chat-head">
        <span id="aiDot" class="status-dot" title="AI backend status"></span>
        <h2 class="chat-title">U_Paul-AI chat</h2>
    </div>
    <div class="chat-sub" id="aiSub">Checking AI backend…</div>
    @if (ViewBag.DbDown == true)
    {
        <div class="alert-ai">History unavailable — database is unreachable. New replies still work but won't be saved.</div>
    }
    @if (ViewBag.DbDown == true)
    {
        <p style="color:#f0888f">History unavailable — database is unreachable. New replies still work but won't be saved.</p>
    }
    <div id="chat">
        @foreach (var m in Model)
        {
            <div class="msg @(m.Role == "user" ? "user" : "bot")"><span class="who">@(m.Role == "user" ? "U" : "✦")</span><span class="body">@m.Content</span></div>
        }
    </div>
    <div class="chat-bar">
        <div class="row">
            <input id="prompt" class="form-control" placeholder="হ্যালো লিখুন বা ask anything…" autocomplete="off" />
            <button id="send" class="send">Send</button>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()
<script>
const box = document.getElementById('chat');
const input = document.getElementById('prompt');
const btn = document.getElementById('send');
const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
function add(text, mine, meta) {
  const d = document.createElement('div');
  d.className = 'msg ' + (mine ? 'user' : 'bot');
  const who = document.createElement('span');
  who.className = 'who';
  who.textContent = mine ? 'U' : '✦';
  const body = document.createElement('span');
  body.className = 'body';
  body.textContent = text;
  d.appendChild(who);
  d.appendChild(body);
  if (meta) { const m = document.createElement('div'); m.className = 'meta'; m.textContent = meta; body.appendChild(m); }
  box.appendChild(d);
  window.scrollTo(0, document.body.scrollHeight);
  return d;
}
async function send() {
  const prompt = input.value.trim();
  if (!prompt) return;
  input.value = '';
  btn.disabled = true;
  add(prompt, true);
  const thinking = add('thinking…', false);
  thinking.classList.add('typing');
  const body = new URLSearchParams({ prompt, __RequestVerificationToken: token });
  const t0 = Date.now();
  try {
    const r = await fetch('/Chat/Send', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body });
    const j = await r.json();
    thinking.remove();
    if (j.reply) add(j.reply, false, (j.skill || '') + ' · ' + ((Date.now() - t0) / 1000).toFixed(1) + 's');
    else add(j.error || ('Error ' + r.status), false);
  } catch (e) { thinking.remove(); add('Error: ' + e.message, false); }
  btn.disabled = false;
  input.focus();
}
btn.onclick = send;
input.onkeydown = e => { if (e.key === 'Enter') send(); };
input.focus();
fetch('/healthz').then(r => r.json()).then(j => {
  const dot = document.getElementById('aiDot'), sub = document.getElementById('aiSub');
  if (j.ai) { dot.classList.add('on'); sub.textContent = 'AI backend online · model ready'; }
  else { dot.classList.add('off'); sub.textContent = 'AI backend offline — replies will report the outage.'; }
}).catch(() => {
  document.getElementById('aiDot').classList.add('off');
  document.getElementById('aiSub').textContent = 'Status unreachable.';
});
</script>
