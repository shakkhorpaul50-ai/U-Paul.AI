@model UPaulAi.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="auth-card">
    <h2>Register for U_Paul-AI</h2>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="All"></div>
        <p><label>Email<br /><input asp-for="Email" type="email" class="form-control" /></label></p>
        <p><label>Name (optional)<br /><input asp-for="DisplayName" class="form-control" /></label></p>
        <p><label>Password (8+ chars)<br /><input asp-for="Password" type="password" class="form-control" /></label></p>
        <p><button type="submit" class="btn btn-primary">Register</button>
        <a asp-action="Login">Have an account? Login</a></p>
    </form>
</div>
