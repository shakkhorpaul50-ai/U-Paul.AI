@model UPaulAi.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="auth-card">
    <h2>Change password</h2>
    @if (ViewBag.Done == true)
    {
        <p class="ok">Password changed successfully.</p>
    }
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All"></div>
        <p><label>Current password<br /><input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" /></label></p>
        <p><label>New password (8+ characters)<br /><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /></label></p>
        <p><button type="submit" class="btn btn-primary block">Change password</button></p>
    </form>
</div>
