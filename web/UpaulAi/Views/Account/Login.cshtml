@model UPaulAi.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-card">
    <h2>Login to U_Paul-AI</h2>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="All"></div>
        <p><label>Email<br /><input asp-for="Email" type="email" class="form-control" /></label></p>
        <p><label>Password<br /><input asp-for="Password" type="password" class="form-control" /></label></p>
        <p><label><input asp-for="RememberMe" /> Remember me</label></p>
        <p><button type="submit" class="btn btn-primary">Login</button>
        <a asp-action="Register">Need an account? Register</a></p>
    </form>
</div>
