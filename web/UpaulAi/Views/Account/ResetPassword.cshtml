@model UPaulAi.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set new password";
}
<div class="auth-card">
    <h2>Set a new password</h2>
    <form asp-action="ResetPassword" method="post">
        <input asp-for="Email" type="hidden" />
        <input asp-for="Code" type="hidden" />
        <div asp-validation-summary="All"></div>
        <p><label>New password (8+ characters)<br /><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /></label></p>
        <p><button type="submit" class="btn btn-primary block">Set password</button></p>
    </form>
</div>
