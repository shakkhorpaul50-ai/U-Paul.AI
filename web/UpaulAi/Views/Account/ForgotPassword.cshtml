@model UPaulAi.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth-card">
    <h2>Reset password</h2>
    <p class="sub">Enter your account email and we'll send you a reset link.</p>
    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="All"></div>
        <p><label>Email<br /><input asp-for="Email" type="email" class="form-control" autocomplete="email" /></label></p>
        <p><button type="submit" class="btn btn-primary block">Send reset link</button></p>
        <p class="switch"><a asp-action="Login">Back to login</a></p>
    </form>
</div>
